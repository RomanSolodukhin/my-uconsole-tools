#!/bin/sh
# tmux status segment: current console keyboard layout, tracked by kbdlayoutd.
f="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/kbdlayout"
[ -r "$f" ] || exit 0
l=$(cat "$f" 2>/dev/null) || exit 0
[ -n "$l" ] || exit 0
case "$l" in
	us) printf 'EN' ;;
	*)  printf '%s' "$(echo "$l" | tr '[:lower:]' '[:upper:]')" ;;
esac
