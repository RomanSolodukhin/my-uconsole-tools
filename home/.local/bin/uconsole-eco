#!/usr/bin/env bash
# Backwards-compat alias for the old economy toggle. economy on/off now maps onto
# the mode selector (normal<->economy). Prefer `uconsole-mode` directly.
set -u
MODE_BIN=/home/roman/.local/bin/uconsole-mode

case "${1:-toggle}" in
  on)     exec "$MODE_BIN" economy ;;
  off)    exec "$MODE_BIN" normal ;;
  toggle) exec "$MODE_BIN" cycle ;;
  status) exec "$MODE_BIN" status ;;
  *) echo "usage: uconsole-eco on|off|toggle|status  (alias for uconsole-mode)" >&2; exit 1 ;;
esac
