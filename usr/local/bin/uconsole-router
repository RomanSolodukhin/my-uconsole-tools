#!/bin/bash
# uConsole ROUTER plumbing: share an uplink to the dependent USB device (ESP32-S3).
# The ESP32 downstream is MOCKED for now (ROUTER_MOCK=1) as a veth pair whose peer lives in
# a netns acting as the device, so NAT/forwarding can be tested end-to-end without hardware.
#
#   up     bring up downstream iface (+mock client), ip_forward, nft masquerade, dnsmasq
#   down   tear everything down and restore ip_forward
#   status show uplink, downstream, ip_forward, nft table, dnsmasq, mock client
#   test   from the mock netns, ping through the NAT to prove forwarding
#
# Uplink:
#   ROUTER_UPLINK=auto    use the current default-route iface (safe for testing; e.g. wlan0)
#   ROUTER_UPLINK=modem   power + connect 4G (uconsole-4g enable + nmcli up ROUTER_MODEM_PROFILE)
#   ROUTER_UPLINK=<iface> force a specific egress interface
set -u

CONF=/etc/uconsole-power.conf
STATE=/run/uconsole-router.state
DNSMASQ_PID=/run/uconsole-router-dnsmasq.pid
NFT_TABLE="inet uconsole_router"

# defaults (overridden by conf)
ROUTER_UPLINK=auto
ROUTER_MODEM_PROFILE=cyta-4g
ROUTER_DOWN_IFACE=rt-esp0
ROUTER_MOCK=1
ROUTER_DOWN_GW_CIDR=10.55.0.1/24
ROUTER_DOWN_SUBNET=10.55.0.0/24
ROUTER_DHCP_RANGE=10.55.0.10,10.55.0.50,12h
ROUTER_MOCK_CLIENT_IP=10.55.0.2
ROUTER_MODEM_POWEROFF_ON_DOWN=0
[ -r "$CONF" ] && . "$CONF"

GW_IP="${ROUTER_DOWN_GW_CIDR%/*}"
NS=rt-esp32                       # mock client netns
VPEER="${ROUTER_DOWN_IFACE}c"     # mock client veth end
log() { logger -t uconsole-router "$*"; echo "uconsole-router: $*"; }

resolve_uplink() {
  case "$ROUTER_UPLINK" in
    auto)  ip route show default 2>/dev/null | awk '{print $5; exit}' ;;
    modem)
      command -v uconsole-4g >/dev/null && uconsole-4g enable >/dev/null 2>&1
      nmcli connection up "$ROUTER_MODEM_PROFILE" >/dev/null 2>&1
      # iface that carries the modem profile (wwan*/ppp*), else current default route
      nmcli -g GENERAL.IP-IFACE connection show "$ROUTER_MODEM_PROFILE" 2>/dev/null \
        || ip route show default 2>/dev/null | awk '{print $5; exit}' ;;
    *)     echo "$ROUTER_UPLINK" ;;
  esac
}

downstream_up() {
  if [ "$ROUTER_MOCK" = 1 ]; then
    ip netns add "$NS" 2>/dev/null || true
    if ! ip link show "$ROUTER_DOWN_IFACE" >/dev/null 2>&1; then
      ip link add "$ROUTER_DOWN_IFACE" type veth peer name "$VPEER"
      ip link set "$VPEER" netns "$NS"
    fi
    ip -n "$NS" addr add "${ROUTER_MOCK_CLIENT_IP}/24" dev "$VPEER" 2>/dev/null || true
    ip -n "$NS" link set "$VPEER" up; ip -n "$NS" link set lo up
    ip -n "$NS" route replace default via "$GW_IP" 2>/dev/null || true
  fi
  ip addr add "$ROUTER_DOWN_GW_CIDR" dev "$ROUTER_DOWN_IFACE" 2>/dev/null || true
  ip link set "$ROUTER_DOWN_IFACE" up
}

downstream_down() {
  ip addr del "$ROUTER_DOWN_GW_CIDR" dev "$ROUTER_DOWN_IFACE" 2>/dev/null || true
  if [ "$ROUTER_MOCK" = 1 ]; then
    ip netns del "$NS" 2>/dev/null || true       # also drops the peer veth end
    ip link del "$ROUTER_DOWN_IFACE" 2>/dev/null || true
  fi
}

start_dnsmasq() {
  stop_dnsmasq   # ensure no stale instance (idempotent)
  dnsmasq --pid-file="$DNSMASQ_PID" \
          --interface="$ROUTER_DOWN_IFACE" --bind-interfaces --except-interface=lo \
          --listen-address="$GW_IP" \
          --dhcp-range="$ROUTER_DHCP_RANGE" \
          --dhcp-option=option:router,"$GW_IP" \
          --dhcp-option=option:dns-server,"$GW_IP" \
          --no-hosts --no-resolv --server=1.1.1.1 --server=8.8.8.8 \
          >/dev/null 2>&1 || log "dnsmasq failed to start"
}
stop_dnsmasq() {
  [ -r "$DNSMASQ_PID" ] && kill "$(cat "$DNSMASQ_PID")" 2>/dev/null
  rm -f "$DNSMASQ_PID"
}

nft_up() {  # $1 = uplink iface
  nft add table $NFT_TABLE 2>/dev/null
  nft "add chain $NFT_TABLE postrouting { type nat hook postrouting priority srcnat ; }" 2>/dev/null
  nft "add rule $NFT_TABLE postrouting ip saddr $ROUTER_DOWN_SUBNET oifname \"$1\" masquerade"
}
nft_down() { nft delete table $NFT_TABLE 2>/dev/null || true; }

router_up() {
  [ -r "$STATE" ] && { log "already up (state present); skipping"; return 0; }
  local uplink; uplink=$(resolve_uplink)
  [ -n "$uplink" ] || { log "no uplink iface (ROUTER_UPLINK=$ROUTER_UPLINK)"; exit 1; }
  echo "$(cat /proc/sys/net/ipv4/ip_forward)|$uplink" > "$STATE"
  downstream_up
  sysctl -wq net.ipv4.ip_forward=1
  nft_up "$uplink"
  start_dnsmasq
  log "UP: downstream=$ROUTER_DOWN_IFACE ($ROUTER_DOWN_GW_CIDR) uplink=$uplink mock=$ROUTER_MOCK"
}

router_down() {
  local saved_fwd="" uplink=""
  [ -r "$STATE" ] && IFS='|' read -r saved_fwd uplink < "$STATE"
  stop_dnsmasq
  nft_down
  downstream_down
  [ -n "$saved_fwd" ] && sysctl -wq net.ipv4.ip_forward="$saved_fwd"
  if [ "$ROUTER_UPLINK" = modem ] && [ "$ROUTER_MODEM_POWEROFF_ON_DOWN" = 1 ]; then
    nmcli connection down "$ROUTER_MODEM_PROFILE" >/dev/null 2>&1
    command -v uconsole-4g >/dev/null && uconsole-4g disable >/dev/null 2>&1
  fi
  rm -f "$STATE"
  log "DOWN: torn down, ip_forward restored to ${saved_fwd:-?}"
}

router_status() {
  echo "== uplink ==";        [ -r "$STATE" ] && cut -d'|' -f2 "$STATE" || echo "(down)"
  echo "== ip_forward =="; cat /proc/sys/net/ipv4/ip_forward
  echo "== downstream $ROUTER_DOWN_IFACE =="; ip -br addr show "$ROUTER_DOWN_IFACE" 2>/dev/null || echo "(absent)"
  echo "== nft $NFT_TABLE =="; nft list table $NFT_TABLE 2>/dev/null || echo "(no table)"
  echo "== dnsmasq =="; { [ -r "$DNSMASQ_PID" ] && ps -o pid,args -p "$(cat "$DNSMASQ_PID")" 2>/dev/null; } || echo "(not running)"
  echo "== mock client (netns $NS) =="; ip netns exec "$NS" ip -br addr 2>/dev/null || echo "(no mock netns)"
}

router_test() {
  [ "$ROUTER_MOCK" = 1 ] || { echo "test only for ROUTER_MOCK=1"; exit 1; }
  ip netns exec "$NS" ip addr show >/dev/null 2>&1 || { echo "mock netns down; run 'up' first"; exit 1; }
  echo "== from mock ESP32 ($NS): ping gateway $GW_IP =="
  ip netns exec "$NS" ping -c2 -W2 "$GW_IP"
  echo "== from mock ESP32: ping 8.8.8.8 through NAT =="
  ip netns exec "$NS" ping -c2 -W2 8.8.8.8
  echo "== from mock ESP32: DNS via dnsmasq ($GW_IP) =="
  ip netns exec "$NS" nslookup example.com "$GW_IP" 2>&1 | tail -4 || echo "(nslookup unavailable)"
}

case "${1:-status}" in
  up)     router_up ;;
  down)   router_down ;;
  status) router_status ;;
  test)   router_test ;;
  *) echo "usage: uconsole-router up|down|status|test" >&2; exit 1 ;;
esac
