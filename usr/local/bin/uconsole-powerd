#!/bin/bash
# uConsole power-mode engine. Mode pref (normal|economy|headless|router) selects behaviour.
#
# economy (== old "on") + on battery: CPU powersave + dim screen after IDLE_DIM; auto-shutdown
#   on battery when no input AND no network traffic for the threshold (net resets the SHUTDOWN
#   timer but NOT the dim timer); low/critical battery shuts down on input-idle alone. Warning
#   window (escalating sound) cancellable by any input. On AC: never shut down.
# normal: no economy effects; idle auto-shutdown on battery only (SHUTDOWN_IDLE_NORMAL).
# headless/router (dependent USB device, e.g. ESP32-S3): AC-AGNOSTIC screen-off after
#   HEADLESS_IDLE_OFF, regardless of charger; NEVER idle auto-shutdown; only critical-battery
#   save+poweroff (unattended -> no countdown). headless also: CPU stays ondemand (it computes),
#   wifi off by flag, keep a chosen USB device awake. router: like headless minus wifi-off
#   (keeps wifi as future uplink); 4G/NAT routing NOT implemented yet.
# See ~/Documents/uconsole-power-plan.md.

CONF=/etc/uconsole-power.conf
MODE=/home/roman/.config/uconsole/mode
PREF=/home/roman/.config/uconsole/economy   # legacy fallback for read_mode
AC=/sys/class/power_supply/axp22x-ac/online
BATTERY=/sys/class/power_supply/axp20x-battery/capacity
GOV=/sys/devices/system/cpu/cpufreq/policy0/scaling_governor
SAVE=/usr/local/bin/tmux-resurrect-save
RUNUID=$(id -u roman 2>/dev/null || echo 1000)

# defaults (overridden by conf)
IDLE_DIM=90; DIM_LEVEL=1; CPU_GOVERNOR=powersave; NORMAL_GOVERNOR=ondemand; TICK=5
SHUTDOWN_IDLE_ECO=600; SHUTDOWN_IDLE_NORMAL=900; SHUTDOWN_BATT_OVERRIDE=50; BATT_CRITICAL=5
NET_RATE=20480; NET_QUIET=120; SHUTDOWN_WARN=60; WIFI_PS=on; DRY_RUN=1
WARN_SOUND=/usr/local/share/uconsole/shutdown-warn.wav
WARN_LOUD_AT=30; WARN_URGENT_AT=10; WARN_VOL_LOUD=0.75; WARN_VOL_URGENT=1.0
# headless/router
HEADLESS_IDLE_OFF=30; HEADLESS_WIFI=off; HEADLESS_USB_KEEP=
[ -r "$CONF" ] && . "$CONF"

dimmed=0; saved_bri=""; warn_since=0; warn_stage=0; sink_base=""; was_on_ac=1; prev_mode_logged=""
scr_off=0; scr_bri=""; wifi_blocked=0; router_active=0
last_net_active=0; prev_rx=-1; prev_tx=-1; prev_dev=""; prev_t=0

now()        { local u; read -r u _ < /proc/uptime; echo "${u%.*}"; }
read_mode()  {
  if [ -r "$MODE" ]; then tr -d '[:space:]' < "$MODE"
  elif [ -r "$PREF" ] && [ "$(tr -d '[:space:]' < "$PREF")" = on ]; then echo economy
  else echo normal; fi
}
on_battery() { [ "$(cat "$AC" 2>/dev/null)" = "0" ]; }
batt()       { cat "$BATTERY" 2>/dev/null; }
refresh_bar(){ runuser -u roman -- tmux refresh-client -S 2>/dev/null || true; }
net_dev()    { ip route show default 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1); exit}}'; }

set_gov()        { [ "$(cat "$GOV" 2>/dev/null)" = "$1" ] || echo "$1" > "$GOV" 2>/dev/null; }
assert_wifi_ps() { [ "$WIFI_PS" = "on" ] && iw dev wlan0 set power_save on 2>/dev/null; return 0; }
play_warn() {
  [ -n "$WARN_SOUND" ] && [ -r "$WARN_SOUND" ] || return 0
  runuser -u roman -- env XDG_RUNTIME_DIR="/run/user/$RUNUID" pw-play "$WARN_SOUND" >/dev/null 2>&1 &
}
get_sink()     { runuser -u roman -- env XDG_RUNTIME_DIR="/run/user/$RUNUID" wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | awk '{print $2}'; }
set_sink()     { runuser -u roman -- env XDG_RUNTIME_DIR="/run/user/$RUNUID" wpctl set-volume @DEFAULT_AUDIO_SINK@ "$1" 2>/dev/null; }
restore_sink() { [ -n "$sink_base" ] && set_sink "$sink_base"; sink_base=""; }

dim() {
  [ "$dimmed" = "1" ] && return
  saved_bri=$(brightnessctl -d backlight@0 get 2>/dev/null)
  brightnessctl -q -d backlight@0 set "$DIM_LEVEL" 2>/dev/null
  dimmed=1; refresh_bar
}
undim() {
  [ "$dimmed" = "1" ] || return
  [ -n "$saved_bri" ] && brightnessctl -q -d backlight@0 set "$saved_bri" 2>/dev/null
  dimmed=0; refresh_bar
}
# Full screen-off for headless/router (brightness 0). Separate state from dim().
screen_off() {
  [ "$scr_off" = "1" ] && return
  scr_bri=$(brightnessctl -d backlight@0 get 2>/dev/null)
  brightnessctl -q -d backlight@0 set 0 2>/dev/null
  scr_off=1; refresh_bar
}
screen_on() {
  [ "$scr_off" = "1" ] || return
  [ -n "$scr_bri" ] && brightnessctl -q -d backlight@0 set "$scr_bri" 2>/dev/null
  scr_off=0; refresh_bar
}
wifi_block()   { rfkill block wlan 2>/dev/null; }
wifi_unblock() { rfkill unblock wlan 2>/dev/null; }
apply_usb_keepalive() {  # keep the chosen USB device (HEADLESS_USB_KEEP="VID:PID") from autosuspending
  [ -n "$HEADLESS_USB_KEEP" ] || return
  local vid="${HEADLESS_USB_KEEP%%:*}" pid="${HEADLESS_USB_KEEP##*:}" d
  for d in /sys/bus/usb/devices/*; do
    [ -r "$d/idVendor" ] || continue
    [ "$(cat "$d/idVendor" 2>/dev/null)" = "$vid" ] && [ "$(cat "$d/idProduct" 2>/dev/null)" = "$pid" ] \
      && echo on > "$d/power/control" 2>/dev/null
  done
}
# ROUTER networking is delegated to the uconsole-router helper (NAT/dnsmasq/uplink).
router_ensure_up()   { [ "$router_active" = "1" ] && return; /usr/local/bin/uconsole-router up   >/dev/null 2>&1 & router_active=1; }
router_ensure_down() { [ "$router_active" = "0" ] && return; /usr/local/bin/uconsole-router down >/dev/null 2>&1;   router_active=0; }
# undo anything the new modes changed (called when in normal/economy and on exit)
leave_new_modes() {
  router_ensure_down
  screen_on
  [ "$wifi_blocked" = "1" ] && { wifi_unblock; wifi_blocked=0; }
}
notify_warn() {
  undim
  runuser -u roman -- tmux display-message -d 0 "POWER OFF in ${1}s - press a key to cancel" 2>/dev/null || true
}
cancel_warn() {
  [ "$warn_since" = "0" ] && return
  warn_since=0; warn_stage=0
  restore_sink
  refresh_bar
}
do_shutdown() {
  if [ "$DRY_RUN" = "1" ]; then
    logger -t uconsole-powerd "DRY: would save session + poweroff (mode=$(read_mode) batt=$(batt))"
    cancel_warn
    last=$(now)
    return
  fi
  logger -t uconsole-powerd "idle/critical -> saving session + poweroff"
  "$SAVE"
  systemctl poweroff
}
restore_all() { undim; leave_new_modes; set_gov "$NORMAL_GOVERNOR"; cancel_warn; }

sample_net() {
  local dev rx tx t db dt rate
  t=$(now); dev=$(net_dev)
  if [ -z "$dev" ]; then prev_dev=""; return; fi
  rx=$(cat "/sys/class/net/$dev/statistics/rx_bytes" 2>/dev/null)
  tx=$(cat "/sys/class/net/$dev/statistics/tx_bytes" 2>/dev/null)
  [ -z "$rx" ] && return
  if [ "$dev" != "$prev_dev" ] || [ "$prev_rx" -lt 0 ]; then
    prev_dev="$dev"; prev_rx="$rx"; prev_tx="$tx"; prev_t="$t"; return
  fi
  dt=$(( t - prev_t )); [ "$dt" -le 0 ] && dt=1
  db=$(( (rx - prev_rx) + (tx - prev_tx) )); [ "$db" -lt 0 ] && db=0
  rate=$(( db / dt ))
  prev_rx="$rx"; prev_tx="$tx"; prev_t="$t"
  [ "$rate" -gt "$NET_RATE" ] && last_net_active="$t"
}

# headless/router: AC-agnostic screen-off, no idle auto-shutdown, critical-battery only.
new_mode_eval() {  # $1 = headless|router
  local t b input_idle
  t=$(now); b=$(batt); [ -z "$b" ] && b=100
  input_idle=$(( t - last ))

  cancel_warn                 # clear any leftover economy countdown
  undim                       # clear any leftover economy dim
  set_gov "$NORMAL_GOVERNOR"  # these modes do work -> don't pin powersave

  if [ "$1" = headless ]; then
    router_ensure_down   # in case we came from router
    [ "$HEADLESS_WIFI" = off ] && [ "$wifi_blocked" = 0 ] && { wifi_block; wifi_blocked=1; }
    apply_usb_keepalive
  else  # router: keep wifi, bring up NAT/dnsmasq/uplink via uconsole-router
    [ "$wifi_blocked" = 1 ] && { wifi_unblock; wifi_blocked=0; }
    router_ensure_up
    [ "$1" != "$prev_mode_logged" ] && logger -t uconsole-powerd "router: uconsole-router up (uplink/NAT/dnsmasq)"
  fi
  prev_mode_logged="$1"

  # screen fully off after idle, regardless of charger
  [ "$input_idle" -ge "$HEADLESS_IDLE_OFF" ] && screen_off

  # NO idle auto-shutdown. Critical battery only: save + poweroff (unattended -> no countdown).
  if on_battery && [ "$b" -le "$BATT_CRITICAL" ]; then
    logger -t uconsole-powerd "$1: critical battery ${b}% -> save + poweroff"
    do_shutdown
  fi
}

trap 'exit 0'      TERM INT
trap 'restore_all' EXIT
trap ':'           USR1

evaluate() {
  sample_net
  local mode; mode=$(read_mode)

  # New modes handled before the battery gate: AC-agnostic, no idle auto-shutdown.
  if [ "$mode" = headless ] || [ "$mode" = router ]; then
    new_mode_eval "$mode"
    return
  fi
  leave_new_modes   # undo new-mode side effects when back in normal/economy

  if ! on_battery; then was_on_ac=1; restore_all; return; fi

  if [ "$was_on_ac" = "1" ]; then
    last=$(now); last_net_active=$(now); was_on_ac=0
  fi

  local eco=off; [ "$mode" = economy ] && eco=on
  prev_mode_logged="$mode"
  local t b input_idle shut_idle la want=0
  t=$(now); b=$(batt); [ -z "$b" ] && b=100
  input_idle=$(( t - last ))
  la=$last; [ "$last_net_active" -gt "$la" ] && la=$last_net_active
  shut_idle=$(( t - la ))

  if [ "$eco" = "on" ]; then
    set_gov "$CPU_GOVERNOR"; assert_wifi_ps
    if [ "$input_idle" -ge "$IDLE_DIM" ] && [ "$warn_since" = "0" ]; then dim; fi
  else
    set_gov "$NORMAL_GOVERNOR"
  fi

  if [ "$eco" = "on" ]; then
    if [ "$b" -le "$BATT_CRITICAL" ]; then
      want=1
    elif [ "$input_idle" -ge "$SHUTDOWN_IDLE_ECO" ] && [ "$b" -lt "$SHUTDOWN_BATT_OVERRIDE" ]; then
      want=1
    elif [ "$shut_idle" -ge "$SHUTDOWN_IDLE_ECO" ]; then
      want=1
    fi
  else
    if [ "$SHUTDOWN_IDLE_NORMAL" -gt 0 ] && [ "$shut_idle" -ge "$SHUTDOWN_IDLE_NORMAL" ]; then
      want=1
    fi
  fi

  if [ "$want" = "1" ]; then
    if [ "$warn_since" = "0" ]; then
      warn_since="$t"; warn_stage=1; sink_base=$(get_sink); play_warn
      notify_warn "$SHUTDOWN_WARN"
    else
      local remaining=$(( SHUTDOWN_WARN - (t - warn_since) ))
      if [ "$remaining" -le 0 ]; then
        do_shutdown
      else
        notify_warn "$remaining"
        if [ "$remaining" -le "$WARN_URGENT_AT" ]; then
          [ "$warn_stage" -lt 3 ] && { set_sink "$WARN_VOL_URGENT"; warn_stage=3; }
          play_warn
        elif [ "$remaining" -le "$WARN_LOUD_AT" ] && [ "$warn_stage" -lt 2 ]; then
          set_sink "$WARN_VOL_LOUD"; warn_stage=2; play_warn
        fi
      fi
    fi
  else
    cancel_warn
  fi
}

last=$(now); last_net_active=$(now)
exec 3< <(libinput debug-events 2>/dev/null)
evaluate
while :; do
  if IFS= read -t "$TICK" -r -u 3 line; then
    last=$(now); undim; screen_on; cancel_warn
  else
    rc=$?
    [ "$rc" -le 128 ] && exit 1
    evaluate
  fi
done
